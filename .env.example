# ADE Configuration — copy to .env (or .env.<environment>) and fill values.
#
# Environment / profile selection:
#   ADE_ENV picks the active profile at launch: local | staging | production
#   (default: local). ADE_ENV is read from the real process/shell environment
#   (not from these files) so it can decide which .env file to load.
#
# Auto-loading & precedence (highest wins):
#   1. Real process/shell environment variables (never overridden)
#   2. .env.<env>   — environment-specific overrides (auto-loaded)
#   3. .env         — shared base defaults (auto-loaded)
#   On startup ADE loads .env.<env> then .env automatically.
#
#   Each environment keeps its own isolated data directory under
#   <ADE_DATA_DIR>/<environment>, so local/staging/production never share
#   state. Per-environment templates live in config/ (local.env.example,
#   staging.env.example, production.env.example) — copy one to .env.<environment>.
ADE_ENV=local

# Base data directory. The active environment is appended automatically,
# e.g. ADE_DATA_DIR=./data + ADE_ENV=local -> ./data/local.
# If unset, an OS-appropriate location is used (%APPDATA%\ade on Windows).
ADE_DATA_DIR=./data

# Log verbosity. If unset, defaults per environment:
#   local=debug, staging=info, production=warn.
# ADE_LOG_LEVEL=info

# Provider API keys (BYOK) — store in the OS keychain, NOT here.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Turso (optional — only if using cloud sync for this environment)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
