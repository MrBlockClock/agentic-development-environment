{
  "$schema": "https://raw.githubusercontent.com/nicholasbs/tauri/refs/heads/dev/crates/tauri-cli/schema/config.schema.json",
  "productName": "ADE Desktop",
  "version": "0.1.0",
  "identifier": "com.ade.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ADE Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:1420 http://localhost:1420",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:1420 ws://localhost:1420 http://127.0.0.1:1420 http://localhost:1420",
        "img-src": "'self' asset: http://asset.localhost blob: data: http://127.0.0.1:1420 http://localhost:1420",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self' 'unsafe-eval' http://127.0.0.1:1420 http://localhost:1420"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
