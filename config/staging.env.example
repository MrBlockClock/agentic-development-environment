# ADE — STAGING profile. Copy to .env.staging and fill values.
ADE_ENV=staging
ADE_DATA_DIR=./data
# Defaults to info for staging.
# ADE_LOG_LEVEL=info

# Staging Turso database (separate from production). Keep the auth token
# in the OS keychain / secret store rather than committing it.
# TURSO_DATABASE_URL=libsql://ade-staging-<org>.turso.io
# TURSO_AUTH_TOKEN=
