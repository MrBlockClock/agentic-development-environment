# ADE — PRODUCTION profile. Copy to .env.production and fill values.
ADE_ENV=production
ADE_DATA_DIR=./data
# Defaults to warn for production.
# ADE_LOG_LEVEL=warn

# Production Turso database. NEVER commit real tokens — load from the OS
# keychain / secret manager at deploy time.
# TURSO_DATABASE_URL=libsql://ade-prod-<org>.turso.io
# TURSO_AUTH_TOKEN=
