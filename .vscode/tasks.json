{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "tauri: build-debug",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--manifest-path",
                "apps/desktop/src-tauri/Cargo.toml",
                "--no-default-features"
            ],
            "group": "build",
            "problemMatcher": ["$rustc"],
            "detail": "Build Tauri desktop app in debug mode (Rust only)."
        },
        {
            "label": "tauri: dev",
            "type": "shell",
            "command": "npm",
            "args": ["run", "tauri", "dev"],
            "options": {
                "cwd": "${workspaceFolder}/apps/desktop"
            },
            "group": "build",
            "problemMatcher": ["$tsc", "$eslint-stylish"],
            "detail": "Run Tauri in dev mode with Vite frontend hot-reload.",
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "cargo: clippy",
            "type": "shell",
            "command": "cargo",
            "args": [
                "clippy",
                "--workspace",
                "--exclude",
                "ade-desktop-app",
                "--",
                "-D",
                "warnings"
            ],
            "group": "test",
            "problemMatcher": ["$rustc"],
            "detail": "Run clippy on the full workspace (excludes desktop app)."
        },
        {
            "label": "cargo: test",
            "type": "shell",
            "command": "cargo",
            "args": [
                "test",
                "--workspace",
                "--exclude",
                "ade-desktop-app"
            ],
            "group": "test",
            "problemMatcher": ["$rustc"],
            "detail": "Run cargo tests on the full workspace (excludes desktop app)."
        },
        {
            "label": "cargo: fmt-check",
            "type": "shell",
            "command": "cargo",
            "args": ["fmt", "--check"],
            "group": "test",
            "problemMatcher": [],
            "detail": "Check rustfmt compliance without writing changes."
        }
    ]
}
